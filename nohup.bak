DROP TABLE IF EXISTS Temperature;
DROP TABLE IF EXISTS Humidite;
DROP TABLE IF EXISTS Saturation;
DROP TABLE IF EXISTS Systemes;
CREATE TABLE Temperature (Temperature_id INT NOT NULL AUTO_INCREMENT, Capteur INT, Temp FLOAT, Date_capteur DATETIME, CONSTRAINT temp_pk PRIMARY KEY (Temperature_id));
CREATE TABLE Humidite (Humidite_id INT NOT NULL AUTO_INCREMENT, Capteur INT, Hum FLOAT, Date_capteur DATETIME, CONSTRAINT hum_pk PRIMARY KEY (Humidite_id));
CREATE TABLE Saturation (Saturation_id INT NOT NULL AUTO_INCREMENT, Capteur INT, Mesure FLOAT, Date_capteur DATETIME, CONSTRAINT sat_pk PRIMARY KEY (Saturation_id));
CREATE TABLE Systemes (Systeme_id INT NOT NULL AUTO_INCREMENT, Systeme VARCHAR(10), Etat BOOL, Date DATETIME, CONSTRAINT sys_pk PRIMARY KEY (Systeme_id));
